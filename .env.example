NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/calfit?schema=public

# --- Authentication ---
# Generate each secret with: crypto.randomBytes(48).toString('base64url')
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
OTP_PEPPER=replace-with-a-different-random-secret-of-at-least-32-characters
# Development only. The app refuses to start if this is set when NODE_ENV=production.
OTP_DEV_FIXED_CODE=123456
# Optional tuning (defaults live in src/config/env.schema.ts):
# JWT_ACCESS_TTL_SECONDS, REFRESH_TTL_DAYS, OTP_TTL_SECONDS, OTP_MAX_ATTEMPTS,
# OTP_RESEND_COOLDOWN_SECONDS, OTP_MAX_SENDS_PER_PHONE_PER_HOUR, OTP_MAX_SENDS_PER_IP_PER_HOUR
